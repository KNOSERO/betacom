# Wartości przeznaczone wyłącznie do lokalnego uruchamiania. Przed użyciem poza nim zmień hasła i JWT_SECRET.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/betacom
COMPOSE_SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/betacom
SPRING_DATASOURCE_USERNAME=betacom
SPRING_DATASOURCE_PASSWORD=betacom

MYSQL_DATABASE=betacom
MYSQL_USER=betacom
MYSQL_PASSWORD=betacom
MYSQL_ROOT_PASSWORD=root

JWT_SECRET=local-development-secret-change-before-deployment-123456
JWT_EXPIRATION=PT1H

LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_WINDOW=PT1M
